# Personal single-user setup — one Notion workspace, one WhatsApp recipient, one SQLite file.
# Copy to repo root as `.env` and fill in your values.

# Notion
# Writes are logged no-ops when false. Sync false skips pull/push entirely.
NOTION_WRITE_ENABLED=true
NOTION_SYNC_ENABLED=true
NOTION_TOKEN=secret_xxx
NOTION_TOPICS_DB_ID=xxx
NOTION_PROBLEMS_DB_ID=xxx
NOTION_SESSIONS_DB_ID=xxx
# Optional — card bank sync (§8). Without this, cards export to CARDS_EXPORT_DIR.
NOTION_CARDS_DB_ID=
CARDS_EXPORT_DIR=./data/cards-export
CARDS_SYNC_FLUSH_INTERVAL_MS=300000

# Backend
PORT=3000
# Optional override of PORT (worktree isolation). Wins when set.
BACKEND_PORT=
# Vite dev server (packages/frontend). Defaults to 5173.
FRONTEND_PORT=5173
NODE_ENV=development
LOG_LEVEL=info

# LLM — OpenRouter
# openrouter | mock | disabled. mock and disabled never call the network.
LLM_PROVIDER=openrouter
# General key — Gemma / OPENROUTER_MODEL
OPENROUTER_API_KEY=
# Coach key — GPT-OSS (COACH_LLM_MODEL) and other coach fallbacks
OPENROUTER_COACH_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
COACH_LLM_MODEL=openai/gpt-oss-120b:free
# Comma-separated fallback chain tried in order after COACH_LLM_MODEL fails
# (rate-limit / zero content / provider error). When unset, OPENROUTER_MODEL is
# used automatically if it differs from the coach model. All-free chains can still
# hit "Provider returned error" under load — one paid model (e.g. openai/gpt-oss-120b
# paid, ~$0.10/M input tokens, pennies/month single-user) ends the flakiness.
COACH_LLM_FALLBACK_MODELS=openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=DSA Mastery OS

# WhatsApp (Meta Cloud API) — Phase 3
# false → sendText is a logged no-op
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_RECIPIENT=
WHATSAPP_API_VERSION=v21.0
# Comma-separated wa_ids allowed to run bot commands (empty = all)
WHATSAPP_ALLOWED_RECIPIENTS=
# Secures POST /api/notifications/weekly-digest
WHATSAPP_NOTIFY_SECRET=

# SQLite
SQLITE_PATH=./data/sqlite/dsa.db
# Overrides SQLITE_PATH when set. Overhaul worktree: ./data/dev/dsa.dev.db
DSA_DB_PATH=
# Pristine file for `pnpm dev:reset`. Defaults to data/dev/dsa.snapshot-2026-10-19.db.
# `pnpm dev:snapshot` copies the dev db to data/dev/snapshots/<timestamp>.db.
# DSA_DB_BASELINE=./data/dev/dsa.snapshot-2026-10-19.db

# Redis is unused today. Prefix is stored so a future client stays isolated.
REDIS_URL=
REDIS_PREFIX=

# Obsidian vault (optional)
OBSIDIAN_VAULT_PATH=

# Intelligence engine weights (tunable)
WEIGHT_URGENCY=0.30
WEIGHT_WEAKNESS=0.25
WEIGHT_CONFIDENCE=0.20
WEIGHT_PREREQUISITE=0.15
WEIGHT_RECENCY=0.10

# Schedulers (in-process node-cron)
ENABLE_SCHEDULERS=true
WEEKLY_DIGEST_CRON=0 20 * * 0
SCHEDULER_TIMEZONE=UTC

# LeetCode (Phase 5) — public profile stats via GraphQL
LEETCODE_USERNAME=

# Problem re-solve spaced repetition (docs/problem-spaced-repetition-design.md §12)
# Capacity defaults are provisional — tune after ~2 weeks of real usage
RESOLVE_SLOTS_WEEKDAY=1
RESOLVE_SLOTS_WEEKEND=2
RESOLVE_SLOW_THRESHOLD_EASY_MIN=25
RESOLVE_SLOW_THRESHOLD_MEDIUM_MIN=45
RESOLVE_SLOW_THRESHOLD_HARD_MIN=75
RESOLVE_RETIRE_CLEAN_STREAK=3
RESOLVE_RETIRE_MIN_STABILITY_DAYS=90
RESOLVE_LEECH_LAPSES=4
RESOLVE_ESCALATE_DAYS=14
