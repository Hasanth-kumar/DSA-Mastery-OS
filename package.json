{
  "name": "dsa-mastery-os",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Autonomous DSA learning intelligence layer over Notion, OpenRouter, and WhatsApp",
  "scripts": {
    "build": "pnpm --filter @dsa/database build && pnpm -r --filter '!@dsa/database' build",
    "dev": "pnpm --filter @dsa/integrations build && pnpm --filter @dsa/integrations dev & pnpm --filter @dsa/backend dev",
    "dev:web": "pnpm --filter @dsa/frontend dev",
    "dev:all": "pnpm --filter @dsa/backend --filter @dsa/frontend -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:seed": "pnpm --filter @dsa/integrations db:seed",
    "db:seed-cards": "pnpm --filter @dsa/integrations db:seed-cards",
    "db:embed-cards": "pnpm --filter @dsa/integrations db:embed-cards",
    "db:generate-cards": "pnpm --filter @dsa/integrations db:generate-cards",
    "db:suggest-problems": "pnpm --filter @dsa/integrations db:suggest-problems",
    "db:dedupe-problems": "pnpm --filter @dsa/integrations db:dedupe-problems",
    "db:repair-schedules": "pnpm --filter @dsa/backend db:repair-schedules",
    "prestart": "pnpm build",
    "start": "NODE_ENV=production SERVE_FRONTEND=true node packages/backend/dist/server.js",
    "study": "bash infrastructure/scripts/study.sh",
    "study:prod": "bash infrastructure/scripts/study-prod.sh",
    "study:stop": "bash infrastructure/scripts/study-stop.sh",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "setup": "bash infrastructure/scripts/setup.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
